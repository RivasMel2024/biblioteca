  "item": [
    {
      "name": "AUTENTICACION",
      "description": "Endpoints de autenticación - Login, Register, Logout",
      "item": [
        {
          "name": "Register - Crear Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('user_token', pm.response.json().token);",
                  "    console.log('Token guardado: ' + pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo Usuario\",\n  \"email\": \"nuevousuario@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "register"]
            },
            "description": "Registrar un nuevo usuario en el sistema"
          }
        },
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var token = pm.response.json().token;",
                  "    pm.environment.set('admin_token', token);",
                  "    console.log('Admin token guardado');",
                  "}",
                  "pm.test('Status code 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contiene token', function() {",
                  "    pm.expect(pm.response.json()).to.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "login"]
            }
          }
        },
