                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Orgullo y Prejuicio\",\n  \"description\": \"Novela de Jane Austen publicada en 1813\",\n  \"ISBN\": \"978-0-14-143951-8\",\n  \"category_id\": \"{{new_category_id}}\",\n  \"total_copies\": 2\n}"
                },
                "url": {
