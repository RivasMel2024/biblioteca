{
  "info": {
    "name": "Biblioteca API - Test Suite",
    "description": "Collection completa para probar la API de Biblioteca con todos los casos de uso",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
